{
  "name": "kookaburra-relay",
  "description": "Self-hosted APNs and FCM push gateway with a bilingual admin console and encrypted PostgreSQL storage",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruivza/KookaburraRelay.git"
  },
  "homepage": "https://github.com/ruivza/KookaburraRelay#readme",
  "bugs": "https://github.com/ruivza/KookaburraRelay/issues",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test test/*.test.js",
    "test:docker": "sh scripts/test-docker.sh",
    "check": "node scripts/check.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,mjs}\"",
    "format:check": "prettier --check \"**/*.{js,mjs}\"",
    "bench": "node scripts/bench.mjs",
    "bench:docker": "sh scripts/test-docker.sh node scripts/bench.mjs",
    "db:up": "docker compose -p kookaburra-relay up -d --wait",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate-sqlite.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1137.0",
    "cbor": "10.0.12",
    "ipaddr.js": "2.5.0",
    "node-app-attest": "1.0.1",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4"
  },
  "version": "0.2.0",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10"
  }
}
