# install.sh generates URL-safe random passwords automatically.
POSTGRES_PASSWORD=replace-with-a-long-random-hex-password
# Non-superuser role for the gateway and backup worker, created with a new
# database volume. Installations without these lines use the superuser until
# ops/create-app-role.sh migrates them; do not add them by hand.
GATEWAY_DB_USER=relay_app
GATEWAY_DB_PASSWORD=replace-with-a-different-long-random-hex-password
GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=3220
# After publishing a GitHub image:
# GATEWAY_IMAGE=ghcr.io/ruivza/kookaburrarelay:latest

# Exact proxy IPs or CIDRs only; empty ignores all forwarding headers.
GATEWAY_TRUSTED_PROXIES=
# Local sensitive backup bundles; keep this directory private.
GATEWAY_BACKUP_DIR=./backups
# Initial defaults only; subsequent changes use the admin backup page.
GATEWAY_BACKUP_INTERVAL_SECONDS=86400
GATEWAY_BACKUP_RETENTION_DAYS=14

# Optional concurrency: background deliveries (1-256) and synchronous
# /v1/notify sends (1-64); see docs/OPERATIONS.md.
# GATEWAY_DELIVERY_WORKERS=32
# GATEWAY_LEGACY_WORKERS=4

# Optional prebuilt backup worker image, otherwise built from source.
# GATEWAY_BACKUP_IMAGE=ghcr.io/ruivza/kookaburrarelay-backup:latest
