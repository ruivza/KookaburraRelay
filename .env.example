# install.sh generates a URL-safe random password automatically.
POSTGRES_PASSWORD=replace-with-a-long-random-hex-password
GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=3220
# After publishing a GitHub image:
# GATEWAY_IMAGE=ghcr.io/your-account/kookaburra-relay:latest

# Exact proxy IPs or CIDRs only; empty ignores all forwarding headers.
GATEWAY_TRUSTED_PROXIES=
# Local sensitive backup bundles; keep this directory private.
GATEWAY_BACKUP_DIR=./backups
# Initial defaults only; subsequent changes use the admin backup page.
GATEWAY_BACKUP_INTERVAL_SECONDS=86400
GATEWAY_BACKUP_RETENTION_DAYS=14

# Optional prebuilt backup worker image, otherwise built from source.
# GATEWAY_BACKUP_IMAGE=ghcr.io/your-account/kookaburra-relay-backup:latest
