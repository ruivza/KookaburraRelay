{
  // Type-checks the gateway's JavaScript without compiling it (npm run typecheck). Loose mode: wrong property
  // names, argument counts and calls are reported; implicit any is allowed.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2024"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src/**/*.js", "scripts/**/*.mjs", "types/*.d.ts"]
}
